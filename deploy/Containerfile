# Denkplan Portfolio Maps: Caddy serving the prerendered SvelteKit site.
# The deploy script stages this file, Caddyfile, and the adapter-static build.
FROM docker.io/library/caddy:2.11.2@sha256:25cdc846626b62d05f6b633b9b40c2c9f6ef89b515dc76133cefd920f7dbe562

COPY Caddyfile /etc/caddy/Caddyfile
COPY build /srv

EXPOSE 8075
